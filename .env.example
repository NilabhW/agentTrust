MANDATE_SIGNING_KEY=replace-with-a-long-random-secret
DB_PATH=./data/mandates.db
PORT=3000
# Optional -- defaults shown. REPLAY_SKEW_MS is the allowed clock skew (+/-) for
# agent request timestamps; STEP_UP_TIMEOUT_MS is how long a step-up approval
# stays pending before auto-denying as a timeout.
REPLAY_SKEW_MS=120000
STEP_UP_TIMEOUT_MS=300000

# Optional -- Program 3 (Razorpay test-mode integration). Leave unset to run
# without payment processing: the Gateway behaves exactly as it did before
# Program 3 existed (order_id stays null, no order_created audit entries,
# no /razorpay/webhook route registered). RAZORPAY_KEY_ID/SECRET come from
# your Razorpay test-mode dashboard; RAZORPAY_WEBHOOK_SECRET is whatever you
# set when configuring a webhook (or any local value, when testing purely
# via `npm run simulate-payment`, which reads this same env var).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional -- Program 5 (Gemini-powered buyer agent, scripts/run-buyer-agent.ts).
# Only needed to actually run `npm run buyer-agent`; the main server doesn't
# use these at all. GEMINI_MODEL defaults to gemini-2.5-flash if unset --
# override it if that model id is no longer current for your API key.
# GATEWAY_URL defaults to http://localhost:3000 (the buyer agent talks to
# the Gateway over real HTTP, like any other external agent).
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash
# GATEWAY_URL=http://localhost:3000

# Optional -- Program 6 (Groq-powered bounded upsell agent). Leave unset to
# run without upsell suggestions: the Gateway behaves exactly as it did
# before Program 6 existed (no /upsell routes registered, no
# upsell_suggested/accepted/declined audit entries). GROQ_MODEL defaults to
# openai/gpt-oss-20b if unset -- override it if that model id is no longer
# current for your API key (Groq's hosted model roster rotates).
# GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=openai/gpt-oss-20b
