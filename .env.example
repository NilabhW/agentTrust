MANDATE_SIGNING_KEY=replace-with-a-long-random-secret
DB_PATH=./data/mandates.db
PORT=3000
# Optional -- defaults shown. REPLAY_SKEW_MS is the allowed clock skew (+/-) for
# agent request timestamps; STEP_UP_TIMEOUT_MS is how long a step-up approval
# stays pending before auto-denying as a timeout.
REPLAY_SKEW_MS=120000
STEP_UP_TIMEOUT_MS=300000
